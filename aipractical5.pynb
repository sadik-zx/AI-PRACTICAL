      },
      "execution_count": 1,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "Knowledge Base\n",
            "----------------------------------------------------------------------\n",
            "\n",
            "R1\n",
            "IF   : laptop_not_turning_on\n",
            "THEN : power_problem\n",
            "Advice: Check the charger, power cable and battery.\n",
            "Priority: 10\n",
            "Confidence: 95%\n",
            "\n",
            "R2\n",
            "IF   : charger_connected AND laptop_not_turning_on\n",
            "THEN : possible_battery_problem\n",
            "Advice: Try another charger or check the battery.\n",
            "Priority: 11\n",
            "Confidence: 92%\n",
            "\n",
            "R3\n",
            "IF   : internet_not_working AND laptop_on\n",
            "THEN : network_problem\n",
            "Advice: Check Wi-Fi settings and restart the router.\n",
            "Priority: 10\n",
            "Confidence: 95%\n",
            "\n",
            "R4\n",
            "IF   : network_problem AND wifi_enabled\n",
            "THEN : router_or_isp_problem\n",
            "Advice: Restart the router and check the Internet Service Provider.\n",
            "Priority: 9\n",
            "Confidence: 90%\n",
            "\n",
            "R5\n",
            "IF   : laptop_on AND laptop_slow\n",
            "THEN : performance_problem\n",
            "Advice: Close unused programs and restart the laptop.\n",
            "Priority: 8\n",
            "Confidence: 90%\n",
            "\n",
            "R6\n",
            "IF   : high_cpu_usage AND laptop_slow\n",
            "THEN : cpu_overload\n",
            "Advice: Close CPU-intensive applications and check Task Manager.\n",
            "Priority: 10\n",
            "Confidence: 94%\n",
            "\n",
            "R7\n",
            "IF   : laptop_slow AND low_disk_space\n",
            "THEN : storage_problem\n",
            "Advice: Delete unnecessary files and free up disk space.\n",
            "Priority: 9\n",
            "Confidence: 91%\n",
            "\n",
            "R8\n",
            "IF   : laptop_hot AND laptop_slow\n",
            "THEN : thermal_problem\n",
            "Advice: Clean the cooling vents and make sure the laptop has proper airflow.\n",
            "Priority: 10\n",
            "Confidence: 93%\n",
            "\n",
            "R9\n",
            "IF   : fan_noisy AND thermal_problem\n",
            "THEN : cooling_system_problem\n",
            "Advice: Inspect the cooling fan and clean the cooling system.\n",
            "Priority: 11\n",
            "Confidence: 94%\n",
            "\n",
            "R10\n",
            "IF   : laptop_on AND screen_black\n",
            "THEN : display_problem\n",
            "Advice: Check the display connection or try an external monitor.\n",
            "Priority: 10\n",
            "Confidence: 91%\n",
            "\n",
            "R11\n",
            "IF   : keyboard_not_working AND laptop_on\n",
            "THEN : keyboard_problem\n",
            "Advice: Check the keyboard connection and keyboard drivers.\n",
            "Priority: 8\n",
            "Confidence: 88%\n",
            "\n",
            "R12\n",
            "IF   : laptop_slow AND unknown_background_process\n",
            "THEN : possible_malware_problem\n",
            "Advice: Run a trusted security scan and inspect unfamiliar processes.\n",
            "Priority: 10\n",
            "Confidence: 82%\n",
            "\n",
            "Laptop Troubleshooting Expert System\n",
            "--------------------------------------------------\n",
            "\n",
            "Answer using yes or no.\n",
            "\n",
            "Is the laptop turned on? yes\n",
            "Is the internet not working? yes\n",
            "Is Wi-Fi enabled? no\n",
            "Is the laptop slow? no\n",
            "Is CPU usage high? yes\n",
            "Is disk space low? no\n",
            "Is the laptop unusually hot? yes\n",
            "Is the fan unusually noisy? no\n",
            "Is the screen black? no\n",
            "Is the keyboard not working? no\n",
            "Is there an unknown background process? yes\n",
            "Is the charger connected? no\n",
            "Is the laptop not turning on? no\n",
            "\n",
            "Initial Facts\n",
            "--------------------------------------------------\n",
            "high_cpu_usage\n",
            "internet_not_working\n",
            "laptop_hot\n",
            "laptop_on\n",
            "unknown_background_process\n",
            "\n",
            "Derived Facts\n",
            "--------------------------------------------------\n",
