    },
    {
      "cell_type": "code",
      "source": [
        "from dataclasses import dataclass\n",
        "from typing import Set, List\n",
        "import json\n",
        "\n",
        "\n",
        "@dataclass\n",
        "class Rule:\n",
        "    rule_id: str\n",
        "    conditions: Set[str]\n",
        "    conclusion: str\n",
        "    advice: str\n",
        "    explanation: str\n",
        "    priority: int = 1\n",
        "    confidence: float = 1.0\n",
        "\n",
        "    def matches(self, facts):\n",
        "        return self.conditions.issubset(facts)\n",
        "\n",
        "\n",
        "class KnowledgeBase:\n",
        "\n",
        "    def __init__(self):\n",
        "        self.rules = []\n",
        "\n",
        "    def add_rule(self, rule):\n",
        "        self.rules.append(rule)\n",
        "\n",
        "    def get_rules_for_goal(self, goal):\n",
        "        return [\n",
        "            rule for rule in self.rules\n",
        "            if rule.conclusion == goal\n",
        "        ]\n",
        "\n",
        "    def show_rules(self):\n",
        "        print(\"\\nKnowledge Base\")\n",
        "        print(\"-\" * 70)\n",
        "\n",
        "        for rule in self.rules:\n",
        "            print(f\"\\n{rule.rule_id}\")\n",
        "            print(\"IF   :\", \" AND \".join(sorted(rule.conditions)))\n",
        "            print(\"THEN :\", rule.conclusion)\n",
        "            print(\"Advice:\", rule.advice)\n",
        "            print(\"Priority:\", rule.priority)\n",
        "            print(\"Confidence:\", f\"{rule.confidence:.0%}\")\n",
        "\n",
        "\n",
        "kb = KnowledgeBase()\n",
        "\n",
        "\n",
        "kb.add_rule(Rule(\n",
        "    \"R1\",\n",
        "    {\"laptop_not_turning_on\"},\n",
        "    \"power_problem\",\n",
        "    \"Check the charger, power cable and battery.\",\n",
        "    \"The laptop is not turning on, so there may be a power problem.\",\n",
        "    10,\n",
        "    0.95\n",
        "))\n",
        "\n",
        "kb.add_rule(Rule(\n",
        "    \"R2\",\n",
        "    {\"laptop_not_turning_on\", \"charger_connected\"},\n",
        "    \"possible_battery_problem\",\n",
        "    \"Try another charger or check the battery.\",\n",
        "    \"The charger is connected but the laptop still does not turn on.\",\n",
        "    11,\n",
        "    0.92\n",
        "))\n",
        "\n",
        "kb.add_rule(Rule(\n",
        "    \"R3\",\n",
        "    {\"laptop_on\", \"internet_not_working\"},\n",
        "    \"network_problem\",\n",
        "    \"Check Wi-Fi settings and restart the router.\",\n",
        "    \"The laptop is on but internet connectivity is unavailable.\",\n",
        "    10,\n",
        "    0.95\n",
        "))\n",
        "\n",
        "kb.add_rule(Rule(\n",
        "    \"R4\",\n",
        "    {\"network_problem\", \"wifi_enabled\"},\n",
        "    \"router_or_isp_problem\",\n",
        "    \"Restart the router and check the Internet Service Provider.\",\n",
        "    \"Wi-Fi is enabled but network connectivity is still unavailable.\",\n",
        "    9,\n",
        "    0.90\n",
        "))\n",
        "\n",
        "kb.add_rule(Rule(\n",
        "    \"R5\",\n",
        "    {\"laptop_on\", \"laptop_slow\"},\n",
        "    \"performance_problem\",\n",
        "    \"Close unused programs and restart the laptop.\",\n",
        "    \"The laptop is working but its performance is slow.\",\n",
        "    8,\n",
        "    0.90\n",
        "))\n",
        "\n",
        "kb.add_rule(Rule(\n",
        "    \"R6\",\n",
        "    {\"laptop_slow\", \"high_cpu_usage\"},\n",
        "    \"cpu_overload\",\n",
        "    \"Close CPU-intensive applications and check Task Manager.\",\n",
        "    \"High CPU usage together with slow performance indicates CPU overload.\",\n",
        "    10,\n",
        "    0.94\n",
        "))\n",
        "\n",
        "kb.add_rule(Rule(\n",
        "    \"R7\",\n",
        "    {\"laptop_slow\", \"low_disk_space\"},\n",
        "    \"storage_problem\",\n",
        "    \"Delete unnecessary files and free up disk space.\",\n",
        "    \"Low disk space can affect system performance.\",\n",
        "    9,\n",
        "    0.91\n",
        "))\n",
        "\n",
        "kb.add_rule(Rule(\n",
        "    \"R8\",\n",
        "    {\"laptop_slow\", \"laptop_hot\"},\n",
        "    \"thermal_problem\",\n",
        "    \"Clean the cooling vents and make sure the laptop has proper airflow.\",\n",
        "    \"Slow performance together with high temperature suggests a thermal problem.\",\n",
        "    10,\n",
        "    0.93\n",
        "))\n",
        "\n",
        "kb.add_rule(Rule(\n",
        "    \"R9\",\n",
        "    {\"thermal_problem\", \"fan_noisy\"},\n",
        "    \"cooling_system_problem\",\n",
        "    \"Inspect the cooling fan and clean the cooling system.\",\n",
        "    \"A thermal problem with unusual fan noise suggests a cooling-system issue.\",\n",
        "    11,\n",
        "    0.94\n",
        "))\n",
        "\n",
        "kb.add_rule(Rule(\n",
        "    \"R10\",\n",
        "    {\"laptop_on\", \"screen_black\"},\n",
        "    \"display_problem\",\n",
        "    \"Check the display connection or try an external monitor.\",\n",
        "    \"The laptop is powered on but the screen is black.\",\n",
        "    10,\n",
        "    0.91\n",
        "))\n",
        "\n",
        "kb.add_rule(Rule(\n",
        "    \"R11\",\n",
        "    {\"laptop_on\", \"keyboard_not_working\"},\n",
        "    \"keyboard_problem\",\n",
        "    \"Check the keyboard connection and keyboard drivers.\",\n",
        "    \"The laptop is on but keyboard input is unavailable.\",\n",
        "    8,\n",
        "    0.88\n",
        "))\n",
        "\n",
        "kb.add_rule(Rule(\n",
        "    \"R12\",\n",
        "    {\"laptop_slow\", \"unknown_background_process\"},\n",
        "    \"possible_malware_problem\",\n",
        "    \"Run a trusted security scan and inspect unfamiliar processes.\",\n",
        "    \"Unknown background activity with poor performance may indicate a security issue.\",\n",
        "    10,\n",
        "    0.82\n",
        "))\n",
        "\n",
        "\n",
        "class InferenceEngine:\n",
        "\n",
        "    def __init__(self, knowledge_base):\n",
        "        self.kb = knowledge_base\n",
        "        self.trace = []\n",
        "\n",
        "    def forward_chaining(self, facts):\n",
        "\n",
        "        facts = set(facts)\n",
        "        self.trace = []\n",
        "\n",
        "        changed = True\n",
        "        iteration = 0\n",
        "\n",
        "        while changed:\n",
        "\n",
        "            changed = False\n",
        "            iteration += 1\n",
        "\n",
        "            matching_rules = [\n",
        "                rule for rule in self.kb.rules\n",
        "                if rule.matches(facts)\n",
        "                and rule.conclusion not in facts\n",
        "            ]\n",
        "\n",
        "            matching_rules.sort(\n",
        "                key=lambda r: (\n",
        "                    r.priority,\n",
        "                    r.confidence,\n",
        "                    len(r.conditions)\n",
        "                ),\n",
        "                reverse=True\n",
        "            )\n",
        "\n",
        "            for rule in matching_rules:\n",
        "\n",
        "                facts.add(rule.conclusion)\n",
        "                changed = True\n",
        "\n",
        "                self.trace.append({\n",
        "                    \"iteration\": iteration,\n",
        "                    \"rule\": rule.rule_id,\n",
        "                    \"conditions\": list(rule.conditions),\n",
        "                    \"conclusion\": rule.conclusion,\n",
        "                    \"confidence\": rule.confidence\n",
        "                })\n",
        "\n",
        "        return facts\n",
        "\n",
        "    def backward_chaining(self, goal, facts, visited=None, level=0):\n",
        "\n",
        "        if visited is None:\n",
        "            visited = set()\n",
        "\n",
        "        if goal in facts:\n",
        "            print(\"  \" * level + \"Fact found:\", goal)\n",
        "            return True\n",
        "\n",
        "        if goal in visited:\n",
        "            return False\n",
        "\n",
        "        visited.add(goal)\n",
        "\n",
        "        print(\"  \" * level + \"Trying to prove:\", goal)\n",
        "\n",
        "        rules = self.kb.get_rules_for_goal(goal)\n",
        "\n",
        "        rules.sort(\n",
        "            key=lambda r: (\n",
        "                r.priority,\n",
        "                r.confidence\n",
        "            ),\n",
        "            reverse=True\n",
        "        )\n",
        "\n",
        "        for rule in rules:\n",
        "\n",
        "            print(\n",
        "                \"  \" * level +\n",
        "                f\"Checking {rule.rule_id}\"\n",
        "            )\n",
        "\n",
        "            possible = True\n",
        "\n",
        "            for condition in rule.conditions:\n",
        "\n",
        "                if not self.backward_chaining(\n",
        "                    condition,\n",
        "                    facts,\n",
        "                    visited,\n",
        "                    level + 1\n",
        "                ):\n",
        "                    possible = False\n",
        "                    break\n",
        "\n",
        "            if possible:\n",
        "                print(\n",
        "                    \"  \" * level +\n",
        "                    \"Goal proved:\",\n",
        "                    goal\n",
        "                )\n",
        "                return True\n",
        "\n",
        "        print(\n",
        "            \"  \" * level +\n",
        "            \"Goal not proved:\",\n",
        "            goal\n",
        "        )\n",
        "\n",
        "        return False\n",
        "\n",
        "\n",
        "class ExplanationEngine:\n",
        "\n",
        "    def __init__(self, knowledge_base):\n",
        "        self.kb = knowledge_base\n",
        "\n",
        "    def explain(self, conclusion):\n",
        "\n",
        "        rules = self.kb.get_rules_for_goal(conclusion)\n",
        "\n",
        "        for rule in rules:\n",
        "\n",
        "            print(f\"\\nRule: {rule.rule_id}\")\n",
        "            print(\n",
        "                \"Conditions:\",\n",
        "                \" AND \".join(sorted(rule.conditions))\n",
        "            )\n",
        "            print(\"Conclusion:\", rule.conclusion)\n",
        "            print(\"Reason:\", rule.explanation)\n",
        "            print(\n",
        "                \"Confidence:\",\n",
        "                f\"{rule.confidence:.0%}\"\n",
        "            )\n",
        "\n",
        "\n",
        "class RecommendationEngine:\n",
        "\n",
        "    def __init__(self, knowledge_base):\n",
        "        self.kb = knowledge_base\n",
        "\n",
        "    def get_recommendations(self, facts):\n",
        "        results = []\n",
        "\n",
        "        for rule in self.kb.rules:\n",
        "\n",
        "            if rule.conclusion in facts:\n",
        "\n",
        "                score = (\n",
        "                    rule.priority *\n",
        "                    rule.confidence *\n",
        "                    len(rule.conditions)\n",
        "                )\n",
        "\n",
        "                results.append({\n",
        "                    \"rule\": rule.rule_id,\n",
        "                    \"problem\": rule.conclusion,\n",
        "                    \"advice\": rule.advice,\n",
        "                    \"confidence\": rule.confidence,\n",
        "                    \"priority\": rule.priority,\n",
        "                    \"score\": score\n",
        "                })\n",
        "\n",
        "        results.sort(\n",
        "            key=lambda x: x[\"score\"],\n",
        "            reverse=True\n",
        "        )\n",
        "\n",
        "        return results\n",
        "\n",
        "\n",
        "inference = InferenceEngine(kb)\n",
        "explainer = ExplanationEngine(kb)\n",
        "recommendation = RecommendationEngine(kb)\n",
        "\n",
        "\n",
        "def run_diagnosis():\n",
        "\n",
        "    print(\"\\nLaptop Troubleshooting Expert System\")\n",
        "    print(\"-\" * 50)\n",
        "\n",
        "    print(\"\\nAnswer using yes or no.\\n\")\n",
        "\n",
        "    questions = {\n",
        "        \"laptop_on\":\n",
        "            \"Is the laptop turned on?\",\n",
        "        \"internet_not_working\":\n",
        "            \"Is the internet not working?\",\n",
        "        \"wifi_enabled\":\n",
        "            \"Is Wi-Fi enabled?\",\n",
        "        \"laptop_slow\":\n",
        "            \"Is the laptop slow?\",\n",
        "        \"high_cpu_usage\":\n",
        "            \"Is CPU usage high?\",\n",
        "        \"low_disk_space\":\n",
        "            \"Is disk space low?\",\n",
        "        \"laptop_hot\":\n",
        "            \"Is the laptop unusually hot?\",\n",
        "        \"fan_noisy\":\n",
        "            \"Is the fan unusually noisy?\",\n",
        "        \"screen_black\":\n",
        "            \"Is the screen black?\",\n",
        "        \"keyboard_not_working\":\n",
        "            \"Is the keyboard not working?\",\n",
        "        \"unknown_background_process\":\n",
        "            \"Is there an unknown background process?\",\n",
        "        \"charger_connected\":\n",
        "            \"Is the charger connected?\",\n",
        "        \"laptop_not_turning_on\":\n",
        "            \"Is the laptop not turning on?\"\n",
        "    }\n",
        "\n",
        "    facts = set()\n",
        "\n",
        "    for name, question in questions.items():\n",
        "\n",
        "        answer = input(question + \" \").strip().lower()\n",
        "\n",
        "        while answer not in [\"yes\", \"no\"]:\n",
        "            print(\"Please enter yes or no.\")\n",
        "            answer = input(question + \" \").strip().lower()\n",
        "\n",
        "        if answer == \"yes\":\n",
        "            facts.add(name)\n",
        "\n",
        "    print(\"\\nInitial Facts\")\n",
        "    print(\"-\" * 50)\n",
        "\n",
        "    for fact in sorted(facts):\n",
        "        print(fact)\n",
        "\n",
        "    final_facts = inference.forward_chaining(facts)\n",
        "\n",
        "    derived_facts = final_facts - facts\n",
        "\n",
        "    print(\"\\nDerived Facts\")\n",
        "    print(\"-\" * 50)\n",
        "\n",
        "    if derived_facts:\n",
        "        for fact in sorted(derived_facts):\n",
        "            print(fact)\n",
        "    else:\n",
        "        print(\"No new facts were derived.\")\n",
        "\n",
        "    print(\"\\nInference Trace\")\n",
        "    print(\"-\" * 50)\n",
        "\n",
        "    for step in inference.trace:\n",
        "\n",
        "        print(\n",
        "            f\"Iteration {step['iteration']} | \"\n",
        "            f\"{step['rule']} | \"\n",
        "            f\"{step['conclusion']} | \"\n",
        "            f\"Confidence: {step['confidence']:.0%}\"\n",
        "        )\n",
        "\n",
        "    results = recommendation.get_recommendations(\n",
        "        final_facts\n",
        "    )\n",
        "\n",
        "    print(\"\\nRecommendations\")\n",
        "    print(\"-\" * 50)\n",
        "\n",
        "    if results:\n",
        "\n",
        "        for i, result in enumerate(results[:5], 1):\n",
        "\n",
        "            print(f\"\\n{i}. {result['problem']}\")\n",
        "            print(\"   Rule:\", result[\"rule\"])\n",
        "            print(\"   Advice:\", result[\"advice\"])\n",
        "            print(\n",
        "                \"   Confidence:\",\n",
        "                f\"{result['confidence']:.0%}\"\n",
        "            )\n",
        "            print(\n",
        "                \"   Priority:\",\n",
        "                result[\"priority\"]\n",
        "            )\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(\n",
        "            \"No matching troubleshooting rule was found.\"\n",
        "        )\n",
        "\n",
        "    return facts, final_facts\n",
        "\n",
        "\n",
        "# Display the rules\n",
        "kb.show_rules()\n",
        "\n",
        "\n",
        "# Run the expert system\n",
        "initial_facts, final_facts = run_diagnosis()\n",
        "\n",
        "\n",
        "# Explanation of derived conclusions\n",
        "print(\"\\nExplanations\")\n",
        "print(\"-\" * 50)\n",
        "\n",
        "for fact in sorted(final_facts - initial_facts):\n",
        "\n",
        "    explainer.explain(fact)\n",
        "\n",
        "\n",
        "# Backward chaining example\n",
        "print(\"\\nBackward Chaining\")\n",
        "print(\"-\" * 50)\n",
        "\n",
        "goal = \"cooling_system_problem\"\n",
        "\n",
        "print(\"Goal:\", goal)\n",
        "\n",
        "proved = inference.backward_chaining(\n",
        "    goal,\n",
        "    initial_facts\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"\\nResult:\",\n",
        "    \"PROVED\" if proved else \"NOT PROVED\"\n",
        ")\n",
        "\n",
        "\n",
        "# Save knowledge base\n",
        "knowledge_base_data = []\n",
        "\n",
        "for rule in kb.rules:\n",
        "\n",
        "    knowledge_base_data.append({\n",
        "        \"rule_id\": rule.rule_id,\n",
        "        \"conditions\": list(rule.conditions),\n",
        "        \"conclusion\": rule.conclusion,\n",
        "        \"advice\": rule.advice,\n",
        "        \"explanation\": rule.explanation,\n",
        "        \"priority\": rule.priority,\n",
        "        \"confidence\": rule.confidence\n",
        "    })\n",
        "\n",
        "\n",
        "with open(\n",
        "    \"laptop_knowledge_base.json\",\n",
        "    \"w\"\n",
        ") as file:\n",
        "\n",
        "    json.dump(\n",
        "        knowledge_base_data,\n",
        "        file,\n",
        "        indent=4\n",
        "    )\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\nKnowledge base saved as \"\n",
        "    \"laptop_knowledge_base.json\"\n",
        ")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
